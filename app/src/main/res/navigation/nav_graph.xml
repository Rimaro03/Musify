<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authCheckFragment">
    <action
        android:id="@+id/action_global_trackOptionsSheet"
        app:destination="@id/trackOptionSheet" />
    <action
        android:id="@+id/action_global_playerFragment"
        app:destination="@id/playerFragment"
        app:enterAnim="@anim/slide_up"
        app:exitAnim="@anim/fade_out"
        app:popEnterAnim="@anim/fade_in"
        app:popExitAnim="@anim/slide_up_rev" />
    <fragment
        android:id="@+id/signinFragment"
        android:name="com.rimaro.musify.ui.signin.SigninFragment"
        tools:layout="@layout/fragment_signin"
        android:label="">
        <action
            android:id="@+id/action_signinFragment_to_signupSplashFragment"
            app:destination="@id/signupSplashFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out" />
        <action
            android:id="@+id/action_signinFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/signupSplashFragment"
        android:name="com.rimaro.musify.ui.signup.SignupSplashFragment"
        android:label=""
        tools:layout="@layout/fragment_signup_splash" >
        <action
            android:id="@+id/action_signupSplashFragment_to_signinFragment"
            app:destination="@id/signinFragment"
            app:enterAnim="@anim/slide_in_rev"
            app:exitAnim="@anim/slide_out_rev" />
        <action
            android:id="@+id/action_signupSplashFragment_to_signupEmailFragment"
            app:destination="@id/signupEmailFragment"
            app:enterAnim="@anim/slide_in"
            app:exitAnim="@anim/slide_out"
            app:popEnterAnim="@anim/slide_in_rev"
            app:popExitAnim="@anim/slide_out_rev" />
    </fragment>
    <fragment
        android:id="@+id/signupEmailFragment"
        android:name="com.rimaro.musify.ui.signup.SignupEmailFragment"
        android:label="Create account"
        tools:layout="@layout/fragment_signup_email" >
        <action
            android:id="@+id/action_signupEmailFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.rimaro.musify.ui.home.HomeFragment"
        android:label=""
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.rimaro.musify.ui.library.LibraryFragment"
        android:label="@string/your_library"
        tools:layout="@layout/fragment_library" >
        <action
            android:id="@+id/action_libraryFragment_to_playlistFragment"
            app:destination="@id/playlistFragment" />
        <action
            android:id="@+id/action_libraryFragment_to_new_playlist_sheet"
            app:destination="@id/newPlaylistSheet" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.rimaro.musify.ui.search.SearchFragment"
        android:label=""
        tools:layout="@layout/fragment_search">

        <argument
            android:name="focusSearchbar"
            app:argType="boolean"
            android:defaultValue="false"/>

    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.rimaro.musify.ui.profile.ProfileFragment"
        android:label=""
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/authCheckFragment"
        android:name="com.rimaro.musify.ui.auth_check.AuthCheckFragment"
        android:label="fragment_auth_check"
        tools:layout="@layout/fragment_auth_check" >
        <action
            android:id="@+id/action_authCheckFragment_to_signinFragment"
            app:destination="@id/signinFragment" />
        <action
            android:id="@+id/action_authCheckFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/playerFragment"
        android:name="com.rimaro.musify.ui.player.PlayerFragment"
        android:label=""
        tools:layout="@layout/fragment_player" />
    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.rimaro.musify.ui.playlist.PlaylistFragment"
        android:label=""
        tools:layout="@layout/fragment_playlist">

        <argument
            android:name="playlistId"
            app:argType="string" />

    </fragment>
    <dialog
        android:id="@+id/newPlaylistSheet"
        android:name="com.rimaro.musify.ui.library.NewPlaylistBottomSheet"
        android:label="NewPlaylistSheet"
        tools:layout="@layout/fragment_new_playlist">
        <action
            android:id="@+id/action_newPlaylist_to_createPlaylist"
            app:destination="@id/createPlaylistDialog" />
    </dialog>
    <dialog
        android:id="@+id/createPlaylistDialog"
        android:name="com.rimaro.musify.ui.library.createPlaylist.CreatePlaylistDialog"
        android:label="CreatePlaylist"
        tools:layout="@layout/dialog_create_playlist" />
    <dialog
        android:id="@+id/trackOptionSheet"
        android:name="com.rimaro.musify.ui.common.trackOptionsSheet.TrackOptionsSheet"
        android:label="TrackOptionSheet"
        tools:layout="@layout/fragment_track_options">
        <argument
            android:name="trackId"
            app:argType="long" />
        <argument
            android:name="playlistId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_trackOptions_to_addToPlaylist"
            app:destination="@id/addToPlaylistSheet"
            app:popUpTo="@id/trackOptionSheet"
            app:popUpToInclusive="true" />
    </dialog>
    <dialog
        android:id="@+id/addToPlaylistSheet"
        android:name="com.rimaro.musify.ui.common.addToPlaylistSheet.AddToPlaylistSheet"
        android:label="AddToPlaylistSheet"
        tools:layout="@layout/fragment_add_to_playlist">
        <argument
            android:name="trackId"
            app:argType="long" />
    </dialog>
</navigation>