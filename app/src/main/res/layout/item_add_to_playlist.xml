<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="5dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/add_to_play_thumbnail"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="@string/track_thumbnail"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@drawable/rounded_track_bg"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:layout_marginEnd="10dp"/>

    <TextView
        android:id="@+id/add_to_play_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="End of Beginning"
        android:textSize="16sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_to_play_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        app:icon="@drawable/media3_icon_plus_circle_unfilled"
        android:contentDescription="@string/menu_icon"
        style="@style/Widget.Material3.Button.IconButton"/>

</LinearLayout>